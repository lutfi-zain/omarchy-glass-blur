#!/usr/bin/env python3
import sys, subprocess, json, re
from pathlib import Path

LOOKNFEEL_FILE = Path.home() / ".config/hypr/looknfeel.lua"
TOGGLE_FILE = Path.home() / ".local/state/omarchy/toggles/bar-blur"
BAR_INVERT_FILE = Path.home() / ".local/state/omarchy/toggles/bar-invert"
BAR_COLOR_FILE = Path.home() / ".local/state/omarchy/toggles/bar-color"
BAR_MODE_FILE = Path.home() / ".local/state/omarchy/toggles/bar-mode"
BAR_OPACITY_FILE = Path.home() / ".local/state/omarchy/toggles/bar-opacity"




def get_option(opt):
    res = subprocess.run(["hyprctl", "-j", "getoption", opt], capture_output=True, text=True)
    try:
        return json.loads(res.stdout)
    except Exception:
        return {}

def is_bar_blur_enabled():
    if TOGGLE_FILE.exists():
        return TOGGLE_FILE.read_text().strip() in ("true", "1", "yes")
    if LOOKNFEEL_FILE.exists():
        content = LOOKNFEEL_FILE.read_text()
        if "-- @omarchy-glass-start" in content and "-- @omarchy-glass-end" in content:
            block = content.split("-- @omarchy-glass-start")[1].split("-- @omarchy-glass-end")[0]
            return "omarchy-bar" in block and "blur = true" in block
        return "omarchy-bar" in content and "blur = true" in block
    return False
def is_bar_invert_enabled():
    if BAR_INVERT_FILE.exists():
        return BAR_INVERT_FILE.read_text().strip() in ("true", "1", "yes")
    return False

def get_bar_custom_color():
    if BAR_COLOR_FILE.exists():
        return BAR_COLOR_FILE.read_text().strip()
    return ""
def get_bar_mode():
    if BAR_MODE_FILE.exists():
        mode = BAR_MODE_FILE.read_text().strip()
        if mode in ("theme", "theme-direct", "invert", "custom"):
            return mode
    if is_bar_invert_enabled():
        return "invert"
    if get_bar_custom_color():
        return "custom"
    return "theme"

def get_bar_glass_opacity():
    if BAR_OPACITY_FILE.exists():
        try:
            val = float(BAR_OPACITY_FILE.read_text().strip())
            if 0.0 <= val <= 1.0:
                return round(val, 2)
        except Exception:
            pass
    return 0.60



def cmd_get():
    active = get_option("decoration:active_opacity").get("float", 0.88)
    inactive = get_option("decoration:inactive_opacity").get("float", 0.78)
    blur_en = get_option("decoration:blur:enabled").get("bool", True)
    passes = get_option("decoration:blur:passes").get("int", 3)
    size = get_option("decoration:blur:size").get("int", 6)
    bar_blur = is_bar_blur_enabled()
    bar_mode = get_bar_mode()
    bar_color = get_bar_custom_color()
    bar_opacity = get_bar_glass_opacity()
    print(json.dumps({
        "activeOpacity": round(active, 2),
        "inactiveOpacity": round(inactive, 2),
        "blurEnabled": blur_en,
        "blurPasses": passes,
        "blurSize": size,
        "barBlur": bar_blur,
        "barColorMode": bar_mode,
        "barInvert": bar_mode == "invert",
        "barColor": bar_color,
        "barGlassOpacity": bar_opacity
    }))

def apply_bar_settings(bar_blur, bar_mode, bar_color, bar_opacity):
    BAR_MODE_FILE.parent.mkdir(parents=True, exist_ok=True)
    BAR_MODE_FILE.write_text(f"{bar_mode}\n")
    BAR_INVERT_FILE.write_text("true\n" if bar_mode == "invert" else "false\n")
    BAR_COLOR_FILE.write_text(f"{bar_color.strip()}\n" if bar_color else "\n")
    BAR_OPACITY_FILE.write_text(f"{bar_opacity:.2f}\n")

    subprocess.run(["omarchy-shell", "-q", "omarchy.bar", "setBarBlur", "true" if bar_blur else "false"], capture_output=True)
    subprocess.run(["omarchy-shell", "-q", "omarchy.bar", "setBarColorMode", bar_mode], capture_output=True)
    subprocess.run(["omarchy-shell", "-q", "omarchy.bar", "setBarColor", bar_color.strip() if bar_color else "none"], capture_output=True)
    subprocess.run(["omarchy-shell", "-q", "omarchy.bar", "setBarOpacity", f"{bar_opacity:.2f}"], capture_output=True)

def apply_hyprland(active, inactive, blur_en, passes, size, bar_blur, bar_mode="theme", bar_color="", bar_opacity=0.60):
    TOGGLE_FILE.parent.mkdir(parents=True, exist_ok=True)
    TOGGLE_FILE.write_text("true\n" if bar_blur else "false\n")
    apply_bar_settings(bar_blur, bar_mode, bar_color, bar_opacity)
    lua_code = f"hl.config({{ decoration = {{ active_opacity = {active:.2f}, inactive_opacity = {inactive:.2f}, blur = {{ enabled = {str(blur_en).lower()}, passes = {passes}, size = {size}, ignore_opacity = true, new_optimizations = true }} }} }})"
    subprocess.run(["hyprctl", "eval", lua_code], capture_output=True)
    if bar_blur:
        bar_lua = 'hl.layer_rule({ match = { namespace = "omarchy-bar" }, blur = true, blur_popups = true, ignore_alpha = 0.0 })'
        subprocess.run(["hyprctl", "eval", bar_lua], capture_output=True)
    else:
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        subprocess.run(["hyprctl", "eval", lua_code], capture_output=True)

def cmd_set(active, inactive, blur_en, passes, size, bar_blur, bar_mode="theme", bar_color="", bar_opacity=0.60):

    # Persist in looknfeel.lua
    if LOOKNFEEL_FILE.exists():
        content = LOOKNFEEL_FILE.read_text()
        bar_rule = '\nhl.layer_rule({ match = { namespace = "omarchy-bar" }, blur = true, blur_popups = true, ignore_alpha = 0.0 })' if bar_blur else ''
        fenced_block = f"""-- @omarchy-glass-start
hl.config({{
  decoration = {{
    active_opacity = {active:.2f},
    inactive_opacity = {inactive:.2f},
    blur = {{
      enabled = {str(blur_en).lower()},
      size = {size},
      passes = {passes},
      ignore_opacity = true,
      new_optimizations = true,
    }},
  }},
}}){bar_rule}
-- @omarchy-glass-end"""
        if "-- @omarchy-glass-start" in content and "-- @omarchy-glass-end" in content:
            new_content = re.sub(r"-- @omarchy-glass-start.*?-- @omarchy-glass-end", fenced_block, content, flags=re.DOTALL)
        else:
            new_content = content.rstrip() + "\n\n" + fenced_block + "\n"
        LOOKNFEEL_FILE.write_text(new_content)
    apply_hyprland(active, inactive, blur_en, passes, size, bar_blur, bar_mode, bar_color, bar_opacity)

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] == "get":
        cmd_get()
    elif sys.argv[1] == "live" and len(sys.argv) >= 7:
        active = float(sys.argv[2])
        inactive = float(sys.argv[3])
        blur_en = sys.argv[4].lower() in ("true", "1", "yes")
        passes = int(sys.argv[5])
        size = int(sys.argv[6])
        bar_blur = sys.argv[7].lower() in ("true", "1", "yes") if len(sys.argv) > 7 else is_bar_blur_enabled()
        bar_mode = sys.argv[8].strip() if len(sys.argv) > 8 else get_bar_mode()
        if bar_mode in ("true", "1", "yes"): bar_mode = "invert"
        elif bar_mode in ("false", "0", "no"): bar_mode = "theme"
        bar_color = sys.argv[9].strip() if len(sys.argv) > 9 else get_bar_custom_color()
        try: bar_opacity = float(sys.argv[10]) if len(sys.argv) > 10 else get_bar_glass_opacity()
        except Exception: bar_opacity = get_bar_glass_opacity()
        apply_hyprland(active, inactive, blur_en, passes, size, bar_blur, bar_mode, bar_color, bar_opacity)
    elif sys.argv[1] == "set" and len(sys.argv) >= 7:
        active = float(sys.argv[2])
        inactive = float(sys.argv[3])
        blur_en = sys.argv[4].lower() in ("true", "1", "yes")
        passes = int(sys.argv[5])
        size = int(sys.argv[6])
        bar_blur = sys.argv[7].lower() in ("true", "1", "yes") if len(sys.argv) > 7 else is_bar_blur_enabled()
        bar_mode = sys.argv[8].strip() if len(sys.argv) > 8 else get_bar_mode()
        if bar_mode in ("true", "1", "yes"): bar_mode = "invert"
        elif bar_mode in ("false", "0", "no"): bar_mode = "theme"
        bar_color = sys.argv[9].strip() if len(sys.argv) > 9 else get_bar_custom_color()
        try: bar_opacity = float(sys.argv[10]) if len(sys.argv) > 10 else get_bar_glass_opacity()
        except Exception: bar_opacity = get_bar_glass_opacity()
        cmd_set(active, inactive, blur_en, passes, size, bar_blur, bar_mode, bar_color, bar_opacity)
